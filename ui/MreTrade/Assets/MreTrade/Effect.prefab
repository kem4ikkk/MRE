    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u0441\u0432\u043E\u044E \u044F\u0447\u0435\u0439\u043A\u0443,
    \u0437\u0430\u0442\u0435\u043C \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043C\u0435\u0436\u0434\u0443 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0451\u043C
    \u0438 \u043E\u0431\u043B\u0430\u0441\u0442\u044C\u044E \u043E\u0431\u043C\u0435\u043D\u0430.
    \u041F\u043E\u0441\u043B\u0435 \u0432\u044B\u0431\u043E\u0440\u0430 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u041F\u041E\u0414\u0422\u0412\u0415\u0420\u0414\u0418\u0422\u042C \u041E\u0411\u041C\u0415\u041D\xBB.
    \u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0430
    \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430."
